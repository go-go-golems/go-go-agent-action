{{- define "review-output-schema" -}}
## ReviewResult JSON Schema

```json
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary_markdown": {
      "type": "string",
      "description": "Markdown summary for GitHub Actions job summary"
    },
    "review_decision": {
      "type": "string",
      "description": "GitHub review decision (APPROVE|COMMENT|REQUEST_CHANGES)"
    },
    "review_body": {
      "type": "string",
      "description": "Main body text of the PR review"
    },
    "issue_comment": {
      "type": "string",
      "description": "Optional additional timeline comment"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "LEFT",
              "RIGHT"
            ]
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "start_side": {
            "type": "string",
            "enum": [
              "LEFT",
              "RIGHT"
            ]
          },
          "subject_type": {
            "type": "string",
            "enum": [
              "file",
              "line"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "path",
              "body",
              "subject_type"
            ],
            "properties": {
              "subject_type": {
                "const": "file"
              }
            }
          },
          {
            "required": [
              "path",
              "body",
              "line",
              "side"
            ],
            "properties": {
              "subject_type": {
                "const": "line"
              }
            }
          },
          {
            "required": [
              "path",
              "body",
              "line",
              "side"
            ],
            "not": {
              "required": [
                "subject_type"
              ]
            }
          }
        ]
      }
    },
    "diary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "files_examined": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "patterns_checked": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "what_i_looked_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "what_i_found": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "what_i_learned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tricky_to_analyze": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "second_pair_of_eyes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "future_work": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_instructions": {
          "type": "string"
        },
        "technical_details": {
          "type": "string"
        }
      }
    }
  }
}
```
{{- end -}}
